# Copy to .env.local (never commit real values)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agendomx_dev
# Optional: enables DB integration tests (constraint / concurrency).
# WARNING: those tests DROP and recreate the schema. Use a disposable database.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/agendomx_test
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Without RESEND_API_KEY, emails are printed to the dev server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM="AgendoMX <citas@agendo.mx>"
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# SENTRY_DSN is a public var in wrangler.jsonc; set it here only to test Sentry locally
SENTRY_DSN=
