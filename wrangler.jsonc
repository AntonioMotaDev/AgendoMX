{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agendomx",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "agendomx" }
  ],
  "observability": { "enabled": true },
  // Cloudflare creates the DNS record and certificate for custom domains on deploy
  // (the zone must be in the same Cloudflare account).
  "routes": [{ "pattern": "agendomx.com", "custom_domain": true }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8131f7fa21544fde9bbefe4a868e8a61",
      // Used by `next dev` / `wrangler dev`. Point it at the Neon `dev` branch.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/agendomx_dev"
    }
  ],
  "r2_buckets": [
    // TODO(owner): `wrangler r2 bucket create agendomx-assets`
    { "binding": "ASSETS_BUCKET", "bucket_name": "agendomx-assets" }
  ],
  "ratelimits": [
    // Public booking: 10 requests per minute per key (IP or phone).
    { "name": "BOOKING_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://agendomx.com",
    "BETTER_AUTH_URL": "https://agendomx.com",
    "EMAIL_FROM": "AgendoMX <citas@agendomx.com>",
    // A DSN is a public client key by design (it ships in browser SDKs too); not a secret.
    "SENTRY_DSN": "https://4575660e8993ba43bf1e2eb34d6e5107@o4512488147714048.ingest.us.sentry.io/4512488176746496",
    "SENTRY_ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "name": "agendomx-staging",
      "routes": [{ "pattern": "staging.agendomx.com", "custom_domain": true }],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "agendomx-staging" }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "73073355c86b4658a0f2f4442ab7ff53",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/agendomx_dev"
        }
      ],
      "r2_buckets": [
        { "binding": "ASSETS_BUCKET", "bucket_name": "agendomx-assets-staging" }
      ],
      "ratelimits": [
        { "name": "BOOKING_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": {
        "NEXT_PUBLIC_APP_URL": "https://staging.agendomx.com",
        "BETTER_AUTH_URL": "https://staging.agendomx.com",
        "EMAIL_FROM": "AgendoMX Staging <citas@agendomx.com>",
        "SENTRY_DSN": "https://4575660e8993ba43bf1e2eb34d6e5107@o4512488147714048.ingest.us.sentry.io/4512488176746496",
        "SENTRY_ENVIRONMENT": "staging",
        // Cloudflare's documented always-passes TEST keys (public, not secrets). Staging only.
        // For real keys: delete both vars, set the real site key here and add TURNSTILE_SECRET_KEY as a Secret.
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      }
    }
  }
}
